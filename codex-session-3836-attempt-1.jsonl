{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat pyproject.toml .pre-commit-config.yaml'","aggregated_output":"[build-system]\nrequires = [\"setuptools>=82.0.1\", \"wheel>=0.47.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"workflows\"\nversion = \"0.1.0\"\ndescription = \"Reusable GitHub Actions workflows and automation infrastructure\"\nreadme = \"README.md\"\nrequires-python = \">=3.12\"\nlicense = \"MIT\"\nauthors = [\n    {name = \"Workflow Contributors\"}\n]\nkeywords = [\"github-actions\", \"workflows\", \"ci-cd\", \"automation\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Build Tools\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Programming Language :: Python :: 3.13\",\n]\n\n[project.urls]\nRepository = \"https://github.com/stranske/Workflows\"\nIssues = \"https://github.com/stranske/Workflows/issues\"\n\n[project.optional-dependencies]\napp = []\ndev = [\n    \"pre-commit==4.6.1\",\n    \"black==26.10.0\",\n    \"ruff==0.16.10\",\n    \"isort==9.0.2\",\n    \"docformatter==1.7.8\",\n    \"mypy==2.4.0\",\n    \"flake8==7.3.0\",\n    \"pytest==9.1.1\",\n    \"pytest-cov==7.1.0\",\n    \"coverage==7.16.2\",\n    \"pytest-xdist==3.8.0\",\n    \"httpx==0.28.1\",  # Native SDK MockTransport regression tests.\n    \"packaging>=26.1\",\n\n    # Required by repo dependency checks / CI fallback checks\n    \"hypothesis>=6.155.2\",\n    \"pandas\",\n    \"numpy<3.0\",\n    \"pydantic>=2.13.4\",\n    \"requests>=2.34.0\",\n    \"jsonschema>=4.26.0\",\n    \"rfc3339-validator>=0.1.4\",\n    \"rfc3986-validator>=0.1.1\",\n    \"PyYAML>=6.0.0\",\n\n    # Used by scripts/sync_test_dependencies.py to edit pyproject.toml\n    \"tomlkit>=0.13.0\",\n    \"referencing\",\n]\n\n# LangChain integration for LLM-enhanced task analysis\n# Install with: pip install -e \".[langchain]\"\n# Versions auto-updated by scripts/update_langchain_versions.py\nlangchain = [\n    \"langchain>=1.3.4,<1.4\",\n    \"langchain-core>=1.5.1,<1.6\",\n    \"langchain-community>=0.4.2,<0.5\",\n    \"langchain-openai>=1.4.1,<1.5\",\n    \"langchain-anthropic>=1.5.2,<1.6\",\n    \"faiss-cpu>=1.14.2,<2.0\",  # Vector store for dedup workflow\n]\n\n[tool.setuptools]\n# This repo is primarily automation + scripts; avoid setuptools trying to auto-discover\n# random top-level dirs as importable packages (which breaks editable installs).\npackages = []\n\n[tool.black]\nline-length = 100\ntarget-version = [\"py312\", \"py313\"]\ninclude = '\\.pyi?$'\nextend-exclude = '''\n/(\n  # Exclude standard directories\n  \\.eggs\n  | \\.git\n  | \\.hg\n  | \\.mypy_cache\n  | \\.tox\n  | \\.venv\n  | _build\n  | buck-out\n  | build\n  | dist\n  | archive\n  | \\.extraction\n)/\n'''\n\n[tool.isort]\nprofile = \"black\"\nline_length = 100\nknown_first_party = []\nknown_third_party = [\"scripts\", \"tools\"]\nskip_glob = [\"archive/*\", \".extraction/*\"]\n\n[tool.ruff]\nline-length = 100\ntarget-version = \"py312\"\nexclude = []\n\n[tool.ruff.lint]\nselect = [\n    \"E\",  # pycodestyle errors\n    \"W\",  # pycodestyle warnings\n    \"F\",  # pyflakes\n    \"I\",  # isort\n    \"B\",  # flake8-bugbear\n    \"C4\",  # flake8-comprehensions\n    \"UP\",  # pyupgrade - modern Python syntax\n    \"SIM\", # flake8-simplify - code simplification\n]\nignore = [\n    \"E501\",  # Line too long (handled by black)\n]\n\n[tool.ruff.lint.isort]\n# Treat scripts.* and tools.* as third-party so import ordering matches consumer\n# repos. Consumer repos have src = [\"src\", \"tests\"] which excludes scripts/ and\n# tools/ from first-party detection. Without this, our repo treats these as\n# first-party (blank line between pydantic and scripts/tools imports) while\n# consumers treat them as third-party (no blank line), causing I001 failures\n# in synced files.\nknown-third-party = [\"scripts\", \"tools\"]\n\n[tool.flake8]\nmax-line-length = 100\nextend-ignore = [\"E501\", \"W503\"]\nexclude = [\n    \".git\",\n    \"__pycache__\",\n    \".venv\",\n    \"venv\",\n    \"archive\",\n    \".extraction\",\n    \"build\",\n    \"dist\",\n]\n\n[tool.mypy]\npython_version = \"3.12\"\nwarn_return_any = true\nwarn_unused_configs = true\ndisallow_untyped_defs = true\nfiles = [\"src\"]\ndisable_error_code = \"import-untyped\"\nexclude = [\n    \"^archive/\",\n    \"^\\\\.extraction/\",\n    \"^templates/\",\n]\n\n[[tool.mypy.overrides]]\nmodule = [\"tests.*\"]\nignore_errors = true\n\n[[tool.mypy.overrides]]\nmodule = [\"scripts.*\", \"tools.*\"]\nfollow_imports = \"skip\"\nignore_errors = true\n\n[tool.pytest.ini_options]\nminversion = \"7.0\"\ntestpaths = [\"tests\", \".github/scripts/__tests__\"]\npython_files = [\"test_*.py\", \"*_test.py\"]\npython_classes = [\"Test*\"]\npython_functions = [\"test_*\"]\naddopts = [\n    \"-ra\",\n    \"--strict-markers\",\n    \"--strict-config\",\n]\nmarkers = [\n    \"integration: marks tests as integration tests (may require external resources)\",\n    \"cosmetic: marks tests for cosmetic/formatting changes\",\n    \"slow: marks tests as slow (deselect with '-m \\\"not slow\\\"')\",\n    \"serial: marks tests that must run serially\",\n    \"xdist_group: marks tests that must share a single xdist worker\",\n]\nfilterwarnings = [\n    \"error\",\n]\n\n[tool.coverage.run]\nbranch = true\nparallel = true\nsource = [\"scripts\", \"tools\", \"src\"]\nomit = [\n    \"*/tests/*\",\n    \"*/test_*.py\",\n    \"*/.venv/*\",\n    \"archive/*\",\n    \".extraction/*\",\n    # CI autofix test fixtures - not production code\n    \"src/trend_analysis/*\",\n]\n\n[tool.coverage.report]\nprecision = 2\nshow_missing = true\nskip_covered = false\n# See https://pre-commit.com for more information\n# See https://pre-commit.com/hooks.html for more hooks\n#\n# Workflows Repository - Git Hooks Configuration\n# Adapted from Workflows with workflow-specific modifications\n#\nexclude: |\n  (?x)(\n    ^archive/|\n    ^\\.extraction/|\n    ^\\.venv/|\n    ^build/|\n    ^dist/\n  )\n\nrepos:\n  # Standard pre-commit hooks\n  - repo: https://github.com/pre-commit/pre-commit-hooks\n    rev: v6.0.0\n    hooks:\n      - id: trailing-whitespace\n        files: '\\.(py|pyi|sh|toml|ya?ml)$'\n      - id: end-of-file-fixer\n        files: '\\.(py|pyi|sh|toml|ya?ml)$'\n      - id: check-yaml\n        exclude: '^\\.github/(workflows|actions)/'  # GitHub Actions YAML has special syntax\n      - id: check-added-large-files\n        args: ['--maxkb=1000']\n      - id: check-executables-have-shebangs\n      - id: check-shebang-scripts-are-executable\n\n  # Python code formatting\n  - repo: https://github.com/psf/black\n    rev: 26.5.1  # Synced with autofix-versions.env\n    hooks:\n      - id: black\n        language_version: python3\n        files: '\\.(py|pyi)$'\n\n  # Python linting and formatting\n  - repo: https://github.com/astral-sh/ruff-pre-commit\n    rev: v0.16.7  # Synced with autofix-versions.env\n    hooks:\n      - id: ruff\n        args: [\"--fix\"]\n        files: '\\.(py|pyi)$'\n\n  # Workflow YAML validation for templates\n  - repo: local\n    hooks:\n      - id: validate-workflow-templates\n        name: Validate workflow templates\n        entry: python3 scripts/validate_workflow_yaml.py\n        language: system\n        files: '^templates/consumer-repo/.github/workflows/.*\\.yml$'\n        pass_filenames: true\n\n  # TODO Phase 4: Add actionlint\n  # - repo: https://github.com/rhysd/actionlint\n  #   rev: v1.6.26\n  #   hooks:\n  #     - id: actionlint\n  #       name: Lint GitHub Actions workflows\n  #       files: '^\\.github/workflows/.*\\.ya?ml$'\n\n  # Local validation hooks\n  - repo: local\n    hooks:\n      # Ultra-fast validation (2-5s) - runs on every commit\n      - id: dev-check\n        name: Ultra-fast development check\n        entry: ./scripts/dev_check.sh\n        language: system\n        pass_filenames: false\n        always_run: true\n        stages: [pre-commit]\n        verbose: true\n\n      # Prevent pushing when behind remote - runs on push\n      - id: check-remote-sync\n        name: Check branch is synced with remote\n        entry: ./scripts/check_remote_sync.sh\n        language: system\n        pass_filenames: false\n        always_run: true\n        stages: [pre-push]\n        verbose: true\n\n      # Adaptive validation (5-30s) - runs on push\n      - id: validate-fast\n        name: Adaptive validation\n        entry: ./scripts/validate_fast.sh\n        language: system\n        pass_filenames: false\n        always_run: true\n        stages: [pre-push]\n        verbose: true\n\n# Installation:\n#   pip install pre-commit\n#   pre-commit install --hook-type pre-commit --hook-type pre-push\n#\n# Usage:\n#   # Run all hooks manually\n#   pre-commit run --all-files\n#\n#   # Run specific hook\n#   pre-commit run dev-check\n#\n#   # Skip hooks for emergency commits\n#   git commit --no-verify\n#   git push --no-verify\n#\n#   # Update hook versions\n#   pre-commit autoupdate\n","exit_code":0,"status":"completed"}}

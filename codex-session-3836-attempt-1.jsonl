 # file\") and kills collection before any test runs.\n            if [ -f pyproject.toml ]; then\n              args+=(\"--cov-config=pyproject.toml\")\n            fi\n            args+=(\"--cov-report=xml:coverage.xml\")\n            args+=(\"--cov-report=term-missing\")\n            args+=(\"--cov-report=json:coverage.json\")\n          fi\n          if [ -n \"${PYTEST_MARKERS}\" ]; then\n            args=(\"-m\" \"${PYTEST_MARKERS}\" \"${args[@]}\")\n          fi\n          if [ -n \"${PYTEST_ARGS}\" ]; then\n            mapfile -t extra_args < <(\n              python -c \\\n                'import os, shlex; print(*shlex.split(os.getenv(\"PYTEST_ARGS\", \"\")), sep=\"\\n\")'\n            )\n            if [ ${#extra_args[@]} -gt 0 ]; then\n              args+=(\"${extra_args[@]}\")\n            fi\n          fi\n          if python -c \"import xdist\" 2>/dev/null; then\n            args+=(\"-n\" \"auto\" \"--dist=loadgroup\")\n            echo \"Running tests in parallel with pytest-xdist (loadgroup scheduler)...\"\n          fi\n          pytest \"${args[@]}\"\n      - name: Enforce coverage minimum\n        id: coverage_min\n        if: ${{ inputs.coverage && inputs['coverage-min'] != '' }}\n        continue-on-error: true\n        env:\n          COVERAGE_MIN: ${{ inputs['coverage-min'] }}\n        run: |\nname: Health 44 Gate Branch Protection\n\non:\n  workflow_call:\n  workflow_dispatch:\n  pull_request:\n    branches: [ main ]\n    types:\n      - opened\n      - synchronize\n      - reopened\n      - ready_for_review\n\npermissions:\n  contents: read\n  pull-requests: read\n  actions: write\n\nenv:\n  ENFORCE_TOKEN: ${{ secrets.BRANCH_PROTECTION_TOKEN }}\n  SNAPSHOT_DIR: gate-branch-protection\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  classify:\n    name: classify changed paths\n    runs-on: ubuntu-latest\n    outputs:\n      is_docs_only: ${{ steps.classify.outputs.is-docs-only || 'false' }}\n      classification_rationale: >-\n        ${{ steps.classify.outputs.classification-rationale || 'path classifier unavailable' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          fetch-depth: 0\n      - name: Classify changed paths\n        id: classify\n        uses: ./.github/actions/path-classifier\n        with:\n          force-full: ${{ github.event_name != 'pull_request' }}\n\n  enforce:\n    needs: classify\n    if: ${{ github.event_name != 'pull_request' || needs.classify.outputs.is_docs_only != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    steps:\n      - uses: actions/checkout@v7\n\n      - name: Compute state fingerprint\n        id: fingerprint\n        env:\n          # Repo-variable storage requires a token with Variables permission.\n          # GITHUB_TOKEN can't access actions/variables even with actions: write.\n          # Prefer BRANCH_PROTECTION_TOKEN (already used downstream); fall back to\n          # GITHUB_TOKEN — the helper handles 401/403 by skipping the optimization.\n          GH_TOKEN: ${{ secrets.BRANCH_PROTECTION_TOKEN || github.token }}\n          GITHUB_TOKEN: ${{ secrets.BRANCH_PROTECTION_TOKEN || github.token }}\n          DEFAULT_BRANCH: >-\n            ${{\n              github.event.repository.default_branch ||\n              github.event.pull_request.base.repo.default_branch ||\n              'main'\n            }}\n        run: |\n          if [ \"${GITHUB_EVENT_NAME}\" = \"pull_request\" ]; then\n            {\n              echo \"should_run=true\"\n              echo \"reason=pull-request-no-repo-variable\"\n              echo \"current_hash=\"\n              echo \"prior_hash=\"\n            } >> \"$GITHUB_OUTPUT\"\n            printf '%s%s\\n' \\\n              '{\"should_run\":\"true\",\"reason\":\"pull-request-no-repo-variable\",' \\\n              '\"current_hash\":\"\",\"prior_hash\":\"\"}'\n            exit 0\n          fi\n\n          python - <<'PY' > /tmp/state-fingerprint-inputs.json\n          import hashlib\n          import json\n          import os\n\n          with open(\".github/config/required-contexts.json\", encoding=\"utf-8\") as handle:\n              required_contexts = json.load(handle)\n          context_hash = hashlib.sha256(\n              json.dumps(required_contexts, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n          ).hexdigest()\n          payload = {\n              \"default_branch\": os.environ.get(\"DEFAULT_BRANCH\", \"main\"),\n              \"required_contexts_hash\": context_hash,\n          }\n          print(json.dumps(payload, sort_keys=True))\n          PY\n\n          python scripts/state_fingerprint.py compare \\\n            --workflow \"${GITHUB_WORKFLOW}\" \\\n            --inputs \"$(cat /tmp/state-fingerprint-inputs.json)\" \\\n            --storage repo-variable\n\n      - name: Report unchanged state skip\n        if: steps.fingerprint.outputs.should_run == 'false'\n        run: echo \"Skipped - ${{ steps.fingerprint.outputs.reason }}\"\n\n      - name: Setup API client\n        if: steps.fingerprint.outputs.should_run == 'true'\n        uses: ./.github/actions/setup-api-client\n        with:\n          # named inputs, not the whole secrets context (see #3185)\n          github_token: ${{ github.token }}\n\n\n\n\n      - name: Determine default branch\n        id: default-branch\n        if: steps.fingerprint.outputs.should_run == 'true'\n        uses: actions/github-script@v9\n        with:\n          script: |\n            const { createTokenAwareRetry } = require('./.github/scripts/github-api-with-retry.js');\n            const { withRetry } = await createTokenAwareRetry({\n              github,\n              core,\n              env: process.env,\n              task: 'health-44-default-branch',\n              capabilities: ['contents:read']\n            });\n\n            const payload = context.payload || {};\n            const eventDefault = payload.repository?.default_branch\n              || payload.pull_request?.base?.repo?.default_branch\n              || payload.workflow_run?.repository?.default_branch\n              || null;\n\n            if (eventDefault && typeof eventDefault === 'string') {\n              core.info(`Using default branch from event payload: ${eventDefault}`);\n              core.setOutput('name', eventDefault);\n              return;\n            }\n\n            const resolvedFallback = payload.repository?.default_branch || null;\n\n            try {\n              const response = await withRetry((client) => client.rest.repos.get({\n                owner: context.repo.owner,\n                repo: context.repo.repo,\n              }));\n              const resolved = response.data.default_branch || resolvedFallback;\n              if (!resolved) {\n                core.setFailed('Repository default branch not available');\n                return;\n              }\n              core.setOutput('name', resolved);\n            } catch (error) {\n              const detail = error?.message || '';\n              const status = error?.status || error?.response?.status;\n              const rateLimited =\n                status === 429 ||\n                (status === 403 && /rate limit/i.test(detail));\n              if (rateLimited) {\n                if (!resolvedFallback) {\n                  core.setFailed('Repository default branch not available');\n                  return;\n                }\n                core.warning('Rate limit while resolving default branch.');\n                core.warning(`Using fallback \"${resolvedFallback}\".`);\n                core.setOutput('name', resolvedFallback);\n              } else {\n                throw error;\n              }\n            }\n\n      - name: Export default branch variable\n        if: steps.fingerprint.outputs.should_run == 'true'\n        run: |\n          echo \"DEFAULT_BRANCH_NAME=${DEFAULT_BRANCH}\" >> \"$GITHUB_ENV\"\n        env:\n          DEFAULT_BRANCH: >-\n            ${{ steps.default-branch.outputs.name || github.event.repository.default_branch }}\n\n      - uses: actions/setup-python@v7\n        if: steps.fingerprint.outputs.should_run == 'true'\n        with:\n          python-version: '3.14'\n\n      - name: Install dependencies\n        if: steps.fingerprint.outputs.should_run == 'true'\n        run: |\n          python -m pip install --upgrade pip\n          pip install requests\n\n      - name: Log enforcement configuration\n        if: steps.fingerprint.outputs.should_run == 'true'\n        run: |\n          if [ -z \"${ENFORCE_TOKEN}\" ]; then\n            echo \"BRANCH_PROTECTION_TOKEN is not configured; enforcement step will be skipped.\"\n","exit_code":0,"status":"completed"}}

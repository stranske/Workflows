{
  "schema_version": "output-substrate/v1",
  "renderer_profile": "investment_review",
  "manifest_ref": "artifact:manifest.json",
  "workspace_bundle_ref": {
    "path": "view/workspace.json",
    "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "artifact_id": "workspace-bundle"
  },
  "link_profile": "artifact-http",
  "manifest_csv_exports": [
    {
      "filename": "exports/core_facts.csv",
      "encoding": "utf-8",
      "columns": [
        {
          "name": "entity",
          "type": "string",
          "source_path": "$.datasets[?(@.id=='core_facts')].rows[*].entity"
        },
        {
          "name": "plan_period",
          "type": "string",
          "source_path": "$.datasets[?(@.id=='core_facts')].rows[*].plan_period"
        },
        {
          "name": "funded_ratio",
          "type": "number",
          "source_path": "$.datasets[?(@.id=='core_facts')].rows[*].value"
        }
      ]
    }
  ]
}

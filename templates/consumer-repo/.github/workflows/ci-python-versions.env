# Shared CI defaults; repo-owned autofix-versions.env overrides tool pins.
# Keep the consumer mirror identical. Runtime support is Python >=3.13 (3.14 first, 3.13 backup).
# Allowed first-party runtime literals (comma-separated); primary runtime below.
CI_PYTHON_VERSIONS=3.13,3.14
CI_PYTHON_VERSION=3.14
BLACK_VERSION=26.10.1
RUFF_VERSION=0.17.1
MYPY_VERSION=2.4.1
PYTEST_VERSION=9.2.0
PYTEST_COV_VERSION=7.1.0
PYTEST_XDIST_VERSION=3.8.0
COVERAGE_VERSION=7.16.2
COVERAGE_MINIMUM=70
DOCFORMATTER_VERSION=1.7.8
ISORT_VERSION=9.0.2

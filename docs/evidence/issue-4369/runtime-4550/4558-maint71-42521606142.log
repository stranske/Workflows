2026-11-08T20:49:57.2262985Z   script: const fs = require('fs');
const { createTokenAwareRetry } = require(
  './.github/scripts/github-api-with-retry.js'
);
const { github: api, paginateWithRetry, withRetry } = await createTokenAwareRetry({
  github,
  core,
  env: process.env,
  task: 'maint-71-measure-completed-campaign',
  capabilities: ['actions:write'],
});
const report = JSON.parse(
  fs.readFileSync('artifacts/sync-pr-merge-report.json', 'utf8'),
);
const allowed = new Set([
  'merged',
  'branch_deleted',
  'branch_delete_failed',
  'stale_closed',
  'campaign_no_change_verified',
]);
const incomplete = (report.results || []).filter(
  (result) => !allowed.has(String(result.status || '')),
);
if (incomplete.length > 0) {
  core.notice(
    `Campaign measurement held: ${incomplete.length} delivery row(s) remain nonterminal`,
  );
  return;
}
const planId = String(process.env.CAMPAIGN_PLAN_ID || '').trim();
if (!planId) {
  core.warning('Campaign completed without an immutable plan id; Health 83 not dispatched');
  return;
}
const title = `Health 83 Dependency Sync Efficiency [${planId}]`;
const runs = await paginateWithRetry(api.rest.actions.listWorkflowRuns, {
  owner: context.repo.owner,
  repo: context.repo.repo,
  workflow_id: 'health-83-dependency-sync-efficiency.yml',
  event: 'workflow_dispatch',
  per_page: 100,
});
if (runs.some((run) => run.display_title === title)) {
  core.notice(`Health 83 already recorded for ${planId}`);
  return;
}
await withRetry((client) => client.rest.actions.createWorkflowDispatch({
  owner: context.repo.owner,
  repo: context.repo.repo,
  workflow_id: 'health-83-dependency-sync-efficiency.yml',
  ref: context.payload.repository?.default_branch || 'main',
  inputs: {
    campaign_plan_id: planId,
    trigger_reason: 'campaign-complete',
  },
}));
core.notice(`Dispatched Health 83 completion measurement for ${planId}`);


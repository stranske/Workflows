2026-11-08T16:18:40.0071223Z   script: const { isConsumerOpenPr } = require('./workflows/.github/scripts/sync_tracker_state');
const branchName = process.env.SYNC_BRANCH;
const escapeRegex = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const exists = await isConsumerOpenPr({
  github,
  consumerRepo: process.env.TARGET_REPOSITORY,
  branchPattern: new RegExp(`^${escapeRegex(branchName)}$`),
  core,
});
// Stable candidate/delivery branches supersede the older
// generation-named branches.  A non-terminal legacy PR must still
// hold the lane: creating a stable PR beside it converts one
// delivery attempt into an avoidable replacement.
const legacyInFlight = await isConsumerOpenPr({
  github,
  consumerRepo: process.env.TARGET_REPOSITORY,
  branchPattern: /^sync\/workflows-[0-9a-f]{12}$/i,
  core,
});
core.setOutput('exists', exists ? 'true' : 'false');
core.setOutput('legacy_in_flight', legacyInFlight ? 'true' : 'false');
if (exists) {
  core.notice(`Existing sync PR is already open for ${branchName}`);
}
if (legacyInFlight) {
  core.warning(
    `Holding ${branchName}: a legacy sync/workflows-* PR is still open and must reach terminal disposition before migration.`,
  );
}


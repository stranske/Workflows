2026-11-08T16:18:31.6482977Z [36;1m    target_lines = ([0m
2026-11-08T16:18:31.6483335Z [36;1m        targets_path.read_text(encoding='utf-8').splitlines()[0m
2026-11-08T16:18:31.6483726Z [36;1m        if targets_path.is_file()[0m
2026-11-08T16:18:31.6484168Z [36;1m        else [][0m
2026-11-08T16:18:31.6484433Z [36;1m    )[0m
2026-11-08T16:18:31.6484705Z [36;1m    if '.gitignore' not in target_lines:[0m
2026-11-08T16:18:31.6485059Z [36;1m        target_lines.append('.gitignore')[0m
2026-11-08T16:18:31.6485393Z [36;1m        targets_path.write_text([0m
2026-11-08T16:18:31.6485814Z [36;1m            ''.join(f"{line}\n" for line in sorted(set(filter(None, target_lines)))),[0m
2026-11-08T16:18:31.6486355Z [36;1m            encoding='utf-8',[0m
2026-11-08T16:18:31.6486654Z [36;1m        )[0m

{
  "schema": "workflows.consumer-sync-review-policy/v1",
  "version": 1,
  "minimum_responses": 1,
  "quiet_period_minutes": 7,
  "maximum_wait_minutes": 15,
  "reviewers": [
    {
      "id": "copilot",
      "logins": ["copilot-pull-request-reviewer", "copilot-pull-request-reviewer[bot]"],
      "check_names": []
    },
    {
      "id": "codex",
      "logins": ["chatgpt-codex-connector", "chatgpt-codex-connector[bot]"],
      "check_names": [],
      "request_comment": "@codex review",
      "reassessment_comment": "@codex please reassess this specific finding",
      "disposition_comment": "@codex address that feedback",
      "disposition_task_transport": "pr-conversation",
      "disposition_task_comment": "@codex address that feedback",
      "disposition_completion_prefixes": ["Codex Review: Didn't find any major issues."],
      "disposition_reviewed_commit_prefix": "**Reviewed commit:** "
    },
    {
      "id": "coderabbit",
      "logins": ["coderabbitai", "coderabbitai[bot]"],
      "check_names": ["CodeRabbit"],
      "reassessment_comment": "@coderabbitai full review"
    }
  ],
  "capacity_patterns": [
    "reviewer unavailable",
    "review unavailable",
    "review capacity unavailable",
    "review rate limited",
    "review rate-limit exceeded",
    "capacity unavailable",
    "rate limit exceeded",
    "quota exhausted",
    "usage limit reached",
    "spending cap reached"
  ],
  "non_response_patterns": [
    "review skipped",
    "review was skipped",
    "review was not performed",
    "review disabled",
    "review is disabled",
    "reviews are disabled",
    "excluded by label",
    "excluded labels"
  ]
}

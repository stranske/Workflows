# Git attributes for Workflows repo
#
# Merge strategies to prevent recurring conflicts on PR-specific files:
# These files contain branch-specific content that differs between PRs.
# Using merge=ours keeps each branch's version during merges.

pr_body.md merge=ours
Issues.txt merge=ours

# CI autofix history is append-only and branch-specific
ci/autofix/history.json merge=ours linguist-generated

# Agent ledger files are metadata, not reviewable code
# Mark as generated to exclude from Copilot/Codex code reviews
.agents/*.yml linguist-generated

# Windows command launchers must retain native line endings after checkout.
*.cmd text eol=crlf
